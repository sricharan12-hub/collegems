# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (local instance or MongoDB Atlas cluster URI).
MONGO_URI=your_mongodb_connection_string
# Set to "true" to spin up an in-memory MongoDB instance instead of connecting
# to MONGO_URI (useful for local dev/testing without a real database).
USE_MEMORY_DB=false

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secure_jwt_secret
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to http://localhost:5173
# if unset.
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend / verification links ──────────────────────────────────────────
# Base URL of the frontend app, used to build links in emails (e.g. email
# verification, password reset). Defaults to http://localhost:5173.
FRONTEND_URL=http://localhost:5173
# Base URL used to build the student ID card verification link. Defaults to
# the incoming request's own protocol/host if unset.
VERIFY_BASE_URL=http://localhost:5000
# Base URL of the frontend app used by temporary/shareable links. Defaults to
# http://localhost:5173.
VITE_BACKEND_URL=http://localhost:5173

# ── Email (nodemailer) ─────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ── Signup restriction ──────────────────────────────────────────────────────
# Optional: restrict registration to emails on this domain (e.g. "college.edu").
# Leave unset to allow any email domain.
COLLEGE_DOMAIN=

# ── ID card branding ────────────────────────────────────────────────────────
COLLEGE_NAME=Smart College of Engineering
COLLEGE_TAGLINE=Smart College Management System

# ── Attendance anomaly detection ───────────────────────────────────────────
# Number of consecutive absences before an alert is raised. Defaults to 3.
CONSECUTIVE_ABSENCE_THRESHOLD=3
# Number of days with no attendance record before an alert is raised. Defaults to 5.
MISSING_ATTENDANCE_DAYS_THRESHOLD=5

# ── ML service ──────────────────────────────────────────────────────────────
# Base URL of the dropout/sentiment prediction ML service. Defaults to
# http://localhost:8000.
ML_SERVICE_URL=http://localhost:8000

# ── Microservices mode (optional, only used by `npm run microservices`) ────
# Name of the microservice this process should run as: auth | finance |
# notification | academics | gateway. Defaults to "gateway".
SERVICE_NAME=gateway
# Set to "true" to use an in-process mock instead of a real RabbitMQ broker.
MOCK_RABBITMQ=true
# RabbitMQ connection URL, used when MOCK_RABBITMQ is not "true". Defaults to
# amqp://localhost:5672.
RABBITMQ_URL=amqp://localhost:5672
